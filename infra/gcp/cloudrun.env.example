# Cloud Run service environment for sec-filing-qa, in the YAML shape `gcloud run deploy
# --env-vars-file` expects. Copy to data/cloudrun.env.yaml (gitignored) and fill in the values.
#
# NO SECRETS HERE: OPENAI_API_KEY / ANTHROPIC_API_KEY / SECQA_API_KEY are mounted from Secret
# Manager with `--set-secrets` (see README.md in this directory).

# Where the container finds / puts the index. The entrypoint downloads SECQA_INDEX_URL when the
# file is absent; with no URL it builds the two-document fixture index so /readyz is 200.
SECQA_DUCKDB_PATH: "/data/index.duckdb"
SECQA_INDEX_URL: "https://github.com/<owner>/sec-filing-qa/releases/download/v0.1.0/index-v0.1.tar.zst"

# Must match the embedder the index was built with: `local` (bge-small-en-v1.5, baked into the
# full image) for the published index, `hashing` for the fixture index.
SECQA_EMBEDDER: "local"

# Default answering provider for anonymous callers. `mock` keeps the public demo free; a vendor
# provider needs its key mounted AND makes every anonymous /v1/ask cost money.
SECQA_PROVIDER: "mock"

# Per-request and per-instance daily USD caps (in-memory; documented as per-instance).
SECQA_MAX_COST_USD: "0.25"
SECQA_DAILY_BUDGET_USD: "5.0"

# Rate limit per client IP (slowapi) and structured JSON logs for Cloud Logging. Cloud Run appends
# the real client to X-Forwarded-For, so the key is the last hop (1); without it every caller
# would share the proxy's bucket.
SECQA_RATE_LIMIT_PER_MIN: "10"
SECQA_TRUSTED_PROXY_HOPS: "1"
SECQA_LOG_JSON: "true"

# Provenance shown by GET /version (the deploy workflow sets it to the commit SHA).
SECQA_GIT_SHA: "unknown"
