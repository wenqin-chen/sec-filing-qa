# Copy to .env (gitignored). Every variable is optional; the service runs with provider=mock when unset.

# Vendor keys (never commit). Only needed for provider=openai:* / anthropic:* and live evals.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# SEC EDGAR fair-access policy requires a declared User-Agent containing a contact email.
SEC_USER_AGENT="Your Name you@example.com"

# secqa settings (prefix SECQA_)
SECQA_PROVIDER=mock
SECQA_EMBEDDER=hashing
SECQA_DUCKDB_PATH=data/index.duckdb
SECQA_INDEX_URL=
SECQA_API_KEY=
SECQA_MAX_COST_USD=0.25
SECQA_DAILY_BUDGET_USD=5.0
# Request deadline (agent wall clock; bound on the rag / closed_book LLM call) and the vendor
# SDK's per-attempt timeout / retries, which shrink to the time left inside a request. The
# platform request timeout must cover REQUEST + PROVIDER * (RETRIES + 1) + headroom (docs/DEPLOY.md).
SECQA_REQUEST_TIMEOUT_S=90
SECQA_PROVIDER_TIMEOUT_S=45
SECQA_PROVIDER_MAX_RETRIES=1
# Rate-limit key: 0 = socket peer (direct exposure, docker compose); 1 behind Cloud Run / Container Apps.
SECQA_TRUSTED_PROXY_HOPS=0
SECQA_CASSETTE_MODE=off
SECQA_LOG_JSON=true
